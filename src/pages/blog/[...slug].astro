---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const published = post.data.pubDate.toLocaleDateString("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const wordCount = post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
const authors = post.data.authors;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="page shell article">
    {
      post.data.cover && (
        <Image
          class="article-cover"
          src={post.data.cover}
          alt={post.data.coverAlt ?? post.data.title}
          widths={[480, 720, 960]}
          sizes="(max-width: 720px) 100vw, 680px"
          loading="eager"
        />
      )
    }
    <header class="article-header">
      <p class="eyebrow">Article</p>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="article-lead">{post.data.description}</p>}
      {authors.length > 0 && <p class="article-byline">By {authors.join(" & ")}</p>}
      <div class="article-meta">
        <time datetime={post.data.pubDate.toISOString()}>{published}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime} min read</span>
      </div>
      {
        post.data.canonicalUrl && (
          <p class="article-source">
            <em>
              Originally posted on{" "}
              <a href={post.data.canonicalUrl} target="_blank" rel="noopener noreferrer">
                Substack
              </a>
              .
            </em>
          </p>
        )
      }
      <div class="tag-list" aria-label="Tags">
        {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
